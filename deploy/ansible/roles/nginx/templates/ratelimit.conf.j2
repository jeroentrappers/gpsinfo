# Managed by Ansible. Rate-limit zones for the GPSinfo routing vhosts (http
# context). The tiles vhost (tiles.appmire.be) is owned by the voltway deploy,
# which ships its own voltway_* zones — this role no longer manages it, so the
# former gpsinfo_tiles / gpsinfo_extract zones are gone.
# Routing API: a few requests per route request (alternatives), bursty at
# trip start / reroute, but not a flood.
limit_req_zone $binary_remote_addr zone=gpsinfo_routing:10m rate=20r/s;

# CORS allowlist: echo the Origin back only for our own web apps (see
# tiles_cors_origin_regex). A non-match yields "" → add_header omits the header
# → the browser blocks the cross-origin read. The native app ignores CORS.
map $http_origin $cors_allow_origin {
    default "";
    "~{{ tiles_cors_origin_regex }}" $http_origin;
}
