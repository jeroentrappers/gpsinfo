# Managed by Ansible — GPSinfo vector tile server ({{ tiles_domain }}).
# Host nginx serves the static pmtiles/styles/fonts/sprites directly (Range
# native) and proxies /extract to the loopback extractor. The ?key= gate lives
# inside the locations (not server scope) so it never blocks ACME challenges.
{% if have_cert | default(false) %}
server {
    server_name {{ tiles_domain }};
    listen [::]:443 ssl;
    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/{{ tiles_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ tiles_domain }}/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    root {{ app_dir }}/data;
    gzip on;
    gzip_types application/json;

    # Offline-region extractor (CPU-heavy → tight limit).
    location /extract {
        if ($arg_key != "{{ tiles_api_key }}") { return 403; }
        limit_req zone=gpsinfo_extract burst=5 nodelay;
        proxy_pass http://127.0.0.1:{{ extract_port }};
        proxy_read_timeout 300s;
    }

    # The tile archive is swapped as build stages complete (coverage grows:
    # belgium -> europe -> planet), so it must revalidate — otherwise a client
    # caches a smaller, stale file for a day. ETag/mtime → cheap 304s when
    # unchanged, fresh fetch when it grows.
    location ~ \.pmtiles$ {
        if ($arg_key != "{{ tiles_api_key }}") { return 403; }
        limit_req zone=gpsinfo_tiles burst=300 nodelay;
        try_files $uri =404;
        add_header Cache-Control "no-cache";
        # Browser map clients (e.g. the Pluvio web PWA) read these cross-origin;
        # MapLibre Native (the app) doesn't care. Key still gates access. Range
        # is a CORS-safelisted request header, so GETs need no preflight.
        add_header Access-Control-Allow-Origin $cors_allow_origin always;
        add_header Vary Origin always;
        add_header Access-Control-Expose-Headers "Accept-Ranges, Content-Range, Content-Length" always;
    }

    # Style JSON — small, and we still tweak the palette, so revalidate
    # (cheap 304s) rather than pin clients to a stale style for a day.
    location /styles/ {
        if ($arg_key != "{{ tiles_api_key }}") { return 403; }
        limit_req zone=gpsinfo_tiles burst=300 nodelay;
        try_files $uri =404;
        add_header Cache-Control "no-cache";
        add_header Access-Control-Allow-Origin $cors_allow_origin always;
        add_header Vary Origin always;
        add_header Access-Control-Expose-Headers "Accept-Ranges, Content-Range, Content-Length" always;
    }

    # Static fonts / sprites (stable — long cache).
    location / {
        if ($arg_key != "{{ tiles_api_key }}") { return 403; }
        limit_req zone=gpsinfo_tiles burst=300 nodelay;
        try_files $uri =404;
        add_header Cache-Control "public, max-age=86400";
        # CORS for browser map clients (see the .pmtiles location).
        add_header Access-Control-Allow-Origin $cors_allow_origin always;
        add_header Vary Origin always;
        add_header Access-Control-Expose-Headers "Accept-Ranges, Content-Range, Content-Length" always;
    }
}

server {
    server_name {{ tiles_domain }};
    listen 80;
    listen [::]:80;
    return 301 https://$host$request_uri;
}
{% else %}
# HTTP-only until certbot issues a cert (first deploy on this domain).
server {
    server_name {{ tiles_domain }};
    listen 80;
    listen [::]:80;

    root {{ app_dir }}/data;

    location /extract {
        if ($arg_key != "{{ tiles_api_key }}") { return 403; }
        proxy_pass http://127.0.0.1:{{ extract_port }};
        proxy_read_timeout 300s;
    }
    location / {
        if ($arg_key != "{{ tiles_api_key }}") { return 403; }
        try_files $uri =404;
        add_header Access-Control-Allow-Origin $cors_allow_origin always;
        add_header Vary Origin always;
        add_header Access-Control-Expose-Headers "Accept-Ranges, Content-Range, Content-Length" always;
    }
}
{% endif %}
