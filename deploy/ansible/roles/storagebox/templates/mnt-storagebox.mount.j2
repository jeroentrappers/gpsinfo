# Managed by Ansible. Hetzner Storage Box (subaccount, scoped to gpsinfo-build)
# mounted over CIFS. nofail + network-online ordering so a Storage Box outage
# never blocks boot.
[Unit]
Description=GPSinfo tiles Storage Box (CIFS)
After=network-online.target
Wants=network-online.target

[Mount]
What={{ storagebox_share }}
Where={{ storagebox_mount }}
Type=cifs
Options=credentials=/etc/gpsinfo-tiles/smb.cred,uid=0,gid=0,file_mode=0644,dir_mode=0755,cache=loose,iocharset=utf8,_netdev,nofail

[Install]
WantedBy=multi-user.target
