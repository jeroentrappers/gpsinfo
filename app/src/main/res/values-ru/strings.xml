    <!-- First-run onboarding tour -->
    <string name="onboarding_title">Добро пожаловать в GPSinfo</string>
    <string name="onboarding_intro">Всё работает офлайн — без Play Services, без API-ключей, без телеметрии. Краткий тур:</string>
