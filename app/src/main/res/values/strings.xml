    <!-- First-run onboarding tour -->
    <string name="onboarding_title" tools:ignore="MissingTranslation">Welcome to GPSinfo</string>
    <string name="onboarding_intro" tools:ignore="MissingTranslation">Everything below works offline — no Play Services, no API keys, no telemetry. Quick tour:</string>
    <string name="onboarding_dashboard_title" tools:ignore="MissingTranslation">Dashboard</string>
    <string name="onboarding_dashboard_body" tools:ignore="MissingTranslation">Live position, satellites, compass, speed, sun. Tap any card to expand it.</string>
    <string name="onboarding_record_title" tools:ignore="MissingTranslation">Record a trail</string>
    <string name="onboarding_record_body" tools:ignore="MissingTranslation">Tap the red dot at the bottom-right to start. Recording continues in the background.</string>
    <string name="onboarding_waypoint_title" tools:ignore="MissingTranslation">Drop a pin</string>
    <string name="onboarding_waypoint_body" tools:ignore="MissingTranslation">Tap the pin icon in the top bar to save the current fix as a one-point trail.</string>
    <string name="onboarding_trails_title" tools:ignore="MissingTranslation">View trails</string>
    <string name="onboarding_trails_body" tools:ignore="MissingTranslation">The map icon in the top bar opens the trails list — import GPX, share, and view on an offline-capable map.</string>
    <string name="onboarding_dismiss" tools:ignore="MissingTranslation">Got it</string>

