    <string name="calibration_scatter_label" tools:ignore="MissingTranslation">Magnetic field cloud</string>
    <string name="calibration_scatter_hint" tools:ignore="MissingTranslation">Dots: recent readings. Ring: estimated hard-iron offset.\nA well-calibrated phone draws a tight ring centred on the cross.</string>
