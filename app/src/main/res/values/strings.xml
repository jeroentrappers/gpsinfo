    <string name="calibration_axis_xz" tools:ignore="MissingTranslation">XZ</string>
    <string name="calibration_axis_yz" tools:ignore="MissingTranslation">YZ</string>
    <string name="calibration_field_label" tools:ignore="MissingTranslation">Field magnitude</string>
    <string name="calibration_field_normal" tools:ignore="MissingTranslation">Within the expected Earth-field range (22 – 70 µT).</string>
    <string name="calibration_field_warning" tools:ignore="MissingTranslation">Outside the expected Earth-field range. Move away from metal, magnets, speakers and laptops, then try again.</string>
    <string name="calibration_hardiron_label" tools:ignore="MissingTranslation">Hard-iron offset</string>
    <string name="calibration_hardiron_detail" tools:ignore="MissingTranslation">Sphere radius %1$.1f µT · RMS %2$.1f µT</string>
    <string name="calibration_how_label" tools:ignore="MissingTranslation">How to calibrate</string>
    <string name="calibration_how_body" tools:ignore="MissingTranslation">1. Move away from large metal objects, magnets, speakers and laptops.\n2. Hold the phone in your hand and slowly rotate it through every orientation — a figure-of-eight motion works.\n3. Keep going until the accuracy chip reads HIGH and coverage approaches 100 %%.\n\nThe phone never stops calibrating in the background; this screen just gives you a way to see what it has measured.</string>
