    <!-- First-run onboarding tour -->
    <string name="onboarding_title">Te damos la bienvenida a GPSinfo</string>
    <string name="onboarding_intro">Todo lo de abajo funciona sin conexión: sin Play Services, sin claves de API y sin telemetría. Un recorrido rápido:</string>
    <string name="onboarding_dashboard_title">Panel</string>
    <string name="onboarding_dashboard_body">Posición, satélites, brújula, velocidad y sol en tiempo real. Toca cualquier tarjeta para ampliarla.</string>
