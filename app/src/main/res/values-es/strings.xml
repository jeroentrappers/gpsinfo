    <string name="onboarding_record_body">Toca el punto rojo abajo a la derecha para empezar. La grabación continúa en segundo plano.</string>
    <string name="onboarding_waypoint_title">Marcar un punto</string>
    <string name="onboarding_waypoint_body">Toca el icono de la chincheta en la barra superior para guardar la posición actual como una ruta de un solo punto.</string>
    <string name="onboarding_trails_title">Ver rutas</string>
