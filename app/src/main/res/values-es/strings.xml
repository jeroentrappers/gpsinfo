    <string name="onboarding_dashboard_body">Posición, satélites, brújula, velocidad y sol en tiempo real. Toca cualquier tarjeta para ampliarla.</string>
    <string name="onboarding_record_title">Grabar una ruta</string>
    <string name="onboarding_record_body">Toca el punto rojo abajo a la derecha para empezar. La grabación continúa en segundo plano.</string>
