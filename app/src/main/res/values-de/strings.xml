    <!-- First-run onboarding tour -->
    <string name="onboarding_title">Willkommen bei GPSinfo</string>
    <string name="onboarding_intro">Alles hier funktioniert offline — keine Play Services, keine API-Schlüssel, keine Telemetrie. Kurze Tour:</string>
    <string name="onboarding_dashboard_title">Dashboard</string>
    <string name="onboarding_dashboard_body">Live-Position, Satelliten, Kompass, Tempo, Sonne. Tippe auf eine Karte, um sie zu öffnen.</string>
    <string name="onboarding_record_title">Track aufzeichnen</string>
    <string name="onboarding_record_body">Tippe unten rechts auf den roten Punkt, um zu starten. Die Aufzeichnung läuft auch im Hintergrund weiter.</string>
    <string name="onboarding_waypoint_title">Wegpunkt setzen</string>
    <string name="onboarding_waypoint_body">Tippe in der oberen Leiste auf das Pin-Symbol, um den aktuellen Fix als Einzelpunkt-Track zu speichern.</string>
    <string name="onboarding_trails_title">Tracks ansehen</string>
    <string name="onboarding_trails_body">Das Kartensymbol in der oberen Leiste öffnet die Track-Liste — GPX importieren, teilen und auf einer offlinefähigen Karte ansehen.</string>
    <string name="onboarding_dismiss">Verstanden</string>

