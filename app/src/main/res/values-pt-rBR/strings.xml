    <string name="onboarding_record_body">Toque no ponto vermelho no canto inferior direito para começar. A gravação continua em segundo plano.</string>
    <string name="onboarding_waypoint_title">Marcar um ponto</string>
    <string name="onboarding_waypoint_body">Toque no ícone de alfinete na barra superior para salvar o fix atual como uma trilha de um ponto só.</string>
    <string name="onboarding_trails_title">Ver trilhas</string>
    <string name="onboarding_trails_body">O ícone de mapa na barra superior abre a lista de trilhas — importe GPX, compartilhe e visualize em um mapa que funciona offline.</string>
