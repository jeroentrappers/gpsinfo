<?xml version="1.0" encoding="utf-8"?>
<!--
    Android Auto capability declaration: "template" = we're a Car App
    Library (templated) app. The category itself (navigation) lives on
    the CarAppService intent-filter in AndroidManifest.xml.

    For the Car App Library to actually surface our service to a head
    unit, this file must be referenced from the application's
    meta-data block in AndroidManifest.xml (com.google.android.gms.car.application).
-->
<automotiveApp>
    <uses name="template" />
</automotiveApp>
