# Fastlane runbook for GPSinfo.
#
# Quick reference:
#   bundle exec fastlane bump             # Bump versionCode (+ changelog stubs)
#   bundle exec fastlane verify           # Run unit tests
#   bundle exec fastlane bundle           # Build a signed AAB (release)
#   bundle exec fastlane screenshots      # Generate Play Store screenshots
#                                         #   (needs a running emulator)
#   bundle exec fastlane deploy_internal  # Upload to Play Console internal track
#   bundle exec fastlane deploy_production # Promote to production
#
# The actual signing config lives in app/build.gradle.kts; this runbook
# does NOT pass keystore credentials around — gradle reads them from
# keystore.properties (gitignored) or the FASTLANE_GPSINFO_* env vars.

require "fileutils"

default_platform(:android)

LOCALES = %w[
  en-US cs-CZ de-DE es-ES fr-FR it-IT ja-JP nl-NL pl-PL pt-BR ru-RU tr-TR
]

platform :android do

  desc "Bump versionCode (+ optional versionName) and scaffold changelog files."
  desc "  fastlane bump                        # versionCode + 1"
  desc "  fastlane bump version:2.2.0          # versionCode + 1, set versionName"
  desc "  fastlane bump code:10 version:2.2.0  # set versionCode explicitly"
  lane :bump do |options|
    # Fastlane chdir's into the fastlane/ folder before running lanes, so
    # resolve repo paths absolutely from the Fastfile's own location.
    repo_root = File.expand_path("..", __dir__)
    gradle_file = File.join(repo_root, "app", "build.gradle.kts")
    contents = File.read(gradle_file)

    # Pull the current values straight out of the Kotlin DSL.
    current_code = contents[/versionCode\s*=\s*(\d+)/, 1]&.to_i
    UI.user_error!("No versionCode found in #{gradle_file}") if current_code.nil?
    current_name = contents[/versionName\s*=\s*"([^"]+)"/, 1]

    new_code = options[:code] ? options[:code].to_i : current_code + 1
    if new_code <= current_code
      UI.user_error!("versionCode must increase: #{new_code} is not greater than #{current_code}")
    end
    new_name = options[:version] || current_name

    # Rewrite both lines in place; the leading indentation is outside the
    # match, so it's preserved.
    contents = contents.sub(/(versionCode\s*=\s*)\d+/, "\\1#{new_code}")
    contents = contents.sub(/(versionName\s*=\s*")[^"]+(")/, "\\1#{new_name}\\2")
    File.write(gradle_file, contents)
    UI.success("versionCode #{current_code} → #{new_code}   versionName #{current_name} → #{new_name}")

    # Scaffold an empty changelog per locale so the new versionCode has
    # release notes to attach to on upload. Existing files are never
    # clobbered — a bump you've already started keeps its text.
    created = []
    LOCALES.each do |locale|
      dir = File.join(repo_root, "fastlane", "metadata", "android", locale, "changelogs")
      FileUtils.mkdir_p(dir)
      path = "#{dir}/#{new_code}.txt"
      next if File.exist?(path)
      File.write(path, "• \n")
      created << path
    end
    UI.important("Scaffolded #{created.length} changelog stub(s).") if created.any?
    UI.message("Fill in: fastlane/metadata/android/*/changelogs/#{new_code}.txt")
    UI.important("Then commit, e.g.: Bump to #{new_name} (vc #{new_code})")
  end

  desc "Run unit tests"
  lane :verify do
    gradle(task: "testDebugUnitTest")
  end

  desc "Build a signed AAB ready for Play upload"
  lane :bundle do
    verify
    gradle(
      task: "bundle",
      build_type: "Release",
      print_command: false
    )
  end

  desc "Generate Play Store screenshots across all supported locales."
  desc "Requires an Android emulator already running (adb devices)."
  desc "Output: fastlane/metadata/android/<locale>/images/phoneScreenshots/"
  lane :screenshots do
    gradle(task: "assembleDebug assembleDebugAndroidTest")
    capture_android_screenshots(
      locales: LOCALES,
      clear_previous_screenshots: true,
      app_apk_path: "app/build/outputs/apk/debug/app-debug.apk",
      tests_apk_path: "app/build/outputs/apk/androidTest/debug/app-debug-androidTest.apk",
      use_adb_root: false
    )
  end

  desc "Upload AAB + metadata to internal testing track."
  desc "Use this for every release before promoting to production."
  lane :deploy_internal do
    bundle
    upload_to_play_store(
      track: "internal",
      release_status: "draft",
      skip_upload_apk: true,
      skip_upload_screenshots: false,
      validate_only: false
    )
  end

  desc "Promote the current internal release to production."
  desc "Runs the standard staged rollout (10% by default)."
  lane :deploy_production do
    upload_to_play_store(
      # Source track to promote FROM — deploy_internal just landed the
      # build here. (Was "production", which has no release on a first
      # rollout, so supply's `releases.select` hit nil and crashed.)
      track: "internal",
      track_promote_to: "production",
      rollout: "0.1",
      skip_upload_apk: true,
      skip_upload_aab: true,
      # Promote only. The listing metadata, screenshots and the
      # per-versionCode changelog were already attached to this release by
      # deploy_internal and travel with it on promote. Re-uploading the
      # changelog here fails ("no version code given") because a promote
      # carries no versionCode of its own.
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Upload only the listing metadata + screenshots (no AAB)."
  desc "Useful for translation tweaks between builds."
  lane :metadata_only do
    upload_to_play_store(
      track: "internal",
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: false,
      skip_upload_screenshots: false
    )
  end
end
