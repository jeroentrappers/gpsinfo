# Copy to `keystore.properties` (gitignored) and fill in the real values.
#
# Generate a release keystore once:
#   keytool -genkey -v -keystore ~/.android/gpsinfo-release.jks \
#     -keyalg RSA -keysize 2048 -validity 36500 -alias gpsinfo
#
# Then point this file at it.
storeFile=/home/you/.android/gpsinfo-release.jks
storePassword=your-keystore-password
keyAlias=gpsinfo
keyPassword=your-key-password
