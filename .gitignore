# Built application files
*.apk
*.ap_
*.aab

# Files for the Dalvik VM
*.dex

# Java/Kotlin class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Android Studio
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/

# Keystore / signing material — never commit these.
*.jks
*.keystore
*.p12
*.pem
*.pfx
keystore.properties
signing.properties
key.properties
secrets.properties
release-keystore*
debug-keystore*

# Environment files / per-developer secrets
.env
.env.*
*.env

# Local publish-to-prod script — contains plaintext keystore + Play
# service-account credentials. NEVER commit. A redacted example is
# tracked as build-production.example.sh.
build-production.sh

# Play Console service account JSON
play-service-account.json

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Google Services (e.g. APIs or Firebase)
google-services.json

# Freeline
freeline.py
freeline/
freeline_project_description.json

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# Version control
vcs.xml

# OS
.DS_Store
Thumbs.db
